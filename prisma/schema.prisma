generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Enable PostGIS support
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis] // Enable the extension in the DB
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bikes        Bike[]
  posts        Post[]
  rides        Ride[]
  liveLocation LiveLocation?
}

model Bike {
  id           String @id @default(uuid())
  brand        String
  model        String
  year         Int
  displacement Int // cc
  image        String?

  // Relationships
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Post {
  id           String   @id @default(uuid())
  content      String
  imageUrl     String?
  locationName String?
  createdAt    DateTime @default(now())

  // Relationships
  userId String
  user   User   @relation(fields: [userId], references: [id])
  rideId String?
  ride   Ride?   @relation(fields: [rideId], references: [id])
}

model Ride {
  id              String   @id @default(uuid())
  title           String
  description     String?
  startTime       DateTime
  difficulty      String // Easy, Moderate, Hard
  route           Json // GeoJSON Route Data
  maxParticipants Int      @default(10)
  createdAt       DateTime @default(now())

  // Relationships
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])
  posts     Post[]
}

model LiveLocation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  // PostGIS types are supported via unsupported type for now in standard Prisma schema without raw SQL migrations,
  // but logically we treat this as a geometry(Point, 4326).
  // Ideally: location Unsupported("geometry(Point, 4326)")
  // For simplicity and compatibility with standard JS handling here, we'll store lat/lng
  // but strictly speaking, efficient querying requires the geometry column.
  
  // Implementing as per request for "Use PostGIS types if possible"
  latitude  Float
  longitude Float
  
  // In a real Postgres setup with PostGIS:
  // coordinates Unsupported("geometry(Point, 4326)")? 

  updatedAt DateTime @updatedAt

  @@index([latitude, longitude], name: "location_idx") // Placeholder for spatial index
}
