generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI") // Updated to use MONGO_URI
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bikes        Bike[]
  posts        Post[]
  rides        Ride[]
  liveLocation LiveLocation?
  achievements UserAchievement[]
}

model Bike {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  brand        String
  model        String
  year         Int
  displacement Int // cc
  image        String?

  // Relationships
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model Post {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  content      String
  imageUrl     String?
  locationName String?
  createdAt    DateTime @default(now())

  // Relationships
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  rideId String? @db.ObjectId
  ride   Ride?   @relation(fields: [rideId], references: [id])
}

model Ride {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  startTime       DateTime
  difficulty      String // Easy, Moderate, Hard
  route           Json // GeoJSON Route Data
  maxParticipants Int      @default(10)
  createdAt       DateTime @default(now())

  // Relationships
  creatorId String @db.ObjectId
  creator   User   @relation(fields: [creatorId], references: [id])
  posts     Post[]
}

model LiveLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  
  latitude  Float
  longitude Float

  updatedAt DateTime @updatedAt
  
  // MongoDB supports geospatial queries but Prisma has limited support.
  // We'll rely on lat/lng or store generic Json for geo queries if needed.
}

model Achievement {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  icon_key        String   
  category        String   
  requirement_type String  
  requirement_value Int
  
  // Relationships
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  unlockedAt    DateTime    @default(now())
  currentProgress Int       @default(0) 
  
  // Relationships
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id])
  achievementId String      @db.ObjectId
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}
